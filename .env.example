# Copy to .env (or set these in your MCP client's server config) and fill in
# what you need. Every variable is optional — the server starts with none set,
# and each tool reports which key it is missing when you call it.
#
# See the "Environment" table in README.md for the per-tool breakdown.

# ─── Solana ──────────────────────────────────────────────────────────────────
# RPC endpoint for all Solana reads and transaction broadcasts. Must be https
# (http is rejected except for localhost validators). Bring your own Helius /
# QuickNode / Triton URL for production traffic.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Adds exact supply + DAS data to pump_snapshot.
HELIUS_API_KEY=

# ─── Signing key — treat like cash ───────────────────────────────────────────
# Default signer for wallet_send / pump_buy and the other execution tools, as a
# base58 secret key. Every signing tool also takes a per-call `secret` argument
# that overrides this. FUNDER_SECRET is accepted as an alias.
# Leave empty unless you intend this server to sign with a standing key.
SOLANA_SECRET_KEY=

# ─── Spend guards (defaults are deliberately conservative) ───────────────────
# Per-transaction cap in SOL. Execution tools throw `over_spend_cap` above it.
MAX_SOL_PER_TX=0.5
# Execution calls refuse until re-issued with `confirm: true`. Set 0 to disable.
REQUIRE_CONFIRM=1
# Upper bound on the Jito tip; larger requested tips are clamped to this.
MAX_JITO_TIP_SOL=0.02

# ─── Ethereum (ens_sns_resolve) ──────────────────────────────────────────────
# Optional — falls back to ethers' default public providers.
# MAINNET_RPC_URL is accepted as an alias.
ETH_RPC_URL=

# ─── Text to speech (speak) ──────────────────────────────────────────────────
# NVIDIA NIM key (nvapi-…) — the free Magpie TTS lane, tried first.
NVIDIA_API_KEY=
# Paid backstop, used against api.openai.com/v1/audio/speech.
OPENAI_API_KEY=

# ─── Avatar generation (generate_avatar) ─────────────────────────────────────
REPLICATE_API_TOKEN=
# Pin a commercial-OK model version, e.g. the latest tencent/hunyuan-3d-3.1.
REPLICATE_TEXT_TO_AVATAR_MODEL=
# Polling interval and overall timeout for Replicate predictions, milliseconds.
REPLICATE_POLL_MS=
REPLICATE_TIMEOUT_MS=

# ─── three.ws endpoints (override only if self-hosting) ──────────────────────
# Canonical $three mint on pump.fun, which the `target: "three"` shortcut
# resolves to. Override only to track an updated $three contract.
THREE_MINT=FeMbDoX7R1Psc4GEcvJdsbNbZA3bfztcyDCatJVJpump
VIEWER_BASE=https://three.ws/viewer
THREE_WS_BASE=https://three.ws
